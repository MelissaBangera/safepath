# Copy this file to .env and fill in your values.
# Never commit .env to version control.

SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://safepath_user:yourpassword@localhost:5432/safepath_db

# OSRM routing server (default runs real separate car/bike/foot profiles;
# router.project-osrm.org's default deployment ignores the profile and
# always returns driving-mode routes, which is wrong for this app)
OSRM_URL=https://routing.openstreetmap.de

# Optional: override the User-Agent sent to Nominatim/Overpass
# USER_AGENT=SafePath-College-Project/1.0 (contact: your-email@example.com)
